{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fore-erp",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "fore-erp-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "fore-erp-3003",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3003"],
      "port": 3003
    },
    {
      "name": "fore-erp-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3006"],
      "port": 3006
    },
    {
      "name": "fore-erp-cloudflare",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["opennextjs-cloudflare", "preview", "--", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "fore-website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "D:/dev/fore-website", "run", "dev", "--", "-p", "3001"],
      "port": 3001
    }
  ]
}
